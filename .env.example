# Configuración de InsForge
VITE_INSFORGE_URL=https://tu-app.region.insforge.app
VITE_INSFORGE_ANON_KEY=tu_insforge_anon_key

# Instrucciones:
# 1. Copia este archivo como .env
# 2. Enlaza el proyecto: npx @insforge/cli link --project-id <id-del-proyecto>
# 3. La URL está en el campo oss_host de .insforge/project.json
# 4. Obtén la anon key con: npx @insforge/cli secrets get ANON_KEY
# 5. Reemplaza los valores de arriba con tus credenciales reales
